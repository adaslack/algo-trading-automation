# ============================================
#  Algo Trading Automation — Environment Config
#  US Market (Multi-Broker Support)
# ============================================

# --- Broker Selection ---
# Options: ibkr
BROKER_TYPE=ibkr

# --- Interactive Brokers ---
# Requires TWS or IB Gateway running locally
# Paper ports: TWS=7497, Gateway=4002. Live ports: TWS=7496, Gateway=4001.
IB_HOST=127.0.0.1
IB_PORT=4002
IB_CLIENT_ID=1

# --- Alpha Vantage (Optional — for macro sentiment) ---
# Get a free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# --- System Settings ---
ENVIRONMENT=development
MAX_RISK_PER_TRADE=0.01

# --- Redis Configuration ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- PostgreSQL Configuration ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_brain
DB_USER=quant_operator
DB_PASSWORD=your_db_password_here
