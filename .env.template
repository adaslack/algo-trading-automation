# ============================================
#  Algo Trading Automation — Environment Config
#  US Market Only (Alpaca Paper/Live Trading)
# ============================================

# --- Alpaca API (Required) ---
# Get your keys at: https://app.alpaca.markets/
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here

# --- Alpha Vantage (Optional — for macro sentiment) ---
# Get a free key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here

# --- System Settings ---
ENVIRONMENT=development
MAX_RISK_PER_TRADE=0.01

# --- Redis Configuration ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- PostgreSQL Configuration ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=trading_brain
DB_USER=quant_operator
DB_PASSWORD=your_db_password_here
